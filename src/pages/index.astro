---
import { getEntry } from "astro:content";
import { Container, Heading, Paragraph, Section } from "../components";
import { Stack } from "../components/Stack/Stack";
import BaseLayout from "../layouts/BaseLayout.astro";
import { PostsGrid } from "../features";

const pageContent = await getEntry("pages", "home");
if (!pageContent) {
  throw new Error("Page content not found: home");
}
---

<BaseLayout title={pageContent.data.title}>
  <Section>
    <Container>
      <Stack>
        <Heading level={1}>{pageContent.data.title}</Heading>

        {pageContent.data.description && (
          <Paragraph>{pageContent.data.description}</Paragraph>
        )}

        <PostsGrid />
      </Stack>
    </Container>
  </Section>
</BaseLayout>
