---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  Container,
  Heading,
  Paragraph,
  Section,
  Stack,
  Line,
  MdxContent,
} from "@/ui";
import { getVisibleCollection } from "@/utils/content";

export async function getStaticPaths() {
  const genericPages = (await getVisibleCollection("pages")).filter((entry) =>
    entry.id.startsWith("generic/"),
  );

  return genericPages.map((page) => ({
    params: { slug: page.id.replace("generic/", "").replace(/\.mdx?$/, "") },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<BaseLayout title={page.data.title}>
  <Section>
    <Container>
      <Stack gap="large">
        <Heading level={1}>{page.data.title}</Heading>

        {
          page.data.description && (
            <Paragraph>{page.data.description}</Paragraph>
          )
        }

        <Line />

        <MdxContent content={Content} />
      </Stack>
    </Container>
  </Section>
</BaseLayout>
