---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  Container,
  Heading,
  Section,
  Stack,
  Link,
  Paragraph,
  MdxContent,
} from "@/ui";
import { PostsGrid } from "@/containers";
import { getVisibleCollection } from "@/utils/content";

export async function getStaticPaths() {
  const authors = await getVisibleCollection("authors");
  return authors.map((author) => ({
    params: { slug: author.data.slug },
    props: { author },
  }));
}

const { author } = Astro.props;
const { Content } = await render(author);
---

<BaseLayout title={author.data.name}>
  <Section>
    <Container>
      <Stack gap="large">
        <Stack>
          <Heading level={1}>{author.data.name}</Heading>
          {author.data.bio && <Paragraph>{author.data.bio}</Paragraph>}

          {
            (author.data.email ||
              author.data.website ||
              author.data.github ||
              author.data.twitter) && (
              <Stack horizontal gap="small">
                {author.data.email && (
                  <Link href={`mailto:${author.data.email}`} underlined>
                    Email
                  </Link>
                )}
                {author.data.website && (
                  <Link href={author.data.website} underlined>
                    Website
                  </Link>
                )}
                {author.data.github && (
                  <Link
                    href={`https://github.com/${author.data.github}`}
                    underlined
                  >
                    GitHub
                  </Link>
                )}
                {author.data.twitter && (
                  <Link
                    href={`https://twitter.com/${author.data.twitter}`}
                    underlined
                  >
                    Twitter
                  </Link>
                )}
              </Stack>
            )
          }

          <MdxContent content={Content} />
        </Stack>

        <Stack>
          <Heading level={2}>Posts by {author.data.name}</Heading>
          <PostsGrid author={author} />
        </Stack>
      </Stack>
    </Container>
  </Section>
</BaseLayout>
