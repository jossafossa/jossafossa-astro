---
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PostsSection } from "../../features";

const pageContent = await getEntry("pages", "posts-index");
if (!pageContent) {
  throw new Error("Page content not found: posts-index");
}
---

<BaseLayout title={pageContent.data.title}>
  <PostsSection
    title={pageContent.data.title}
    description={pageContent.data.description}
  />
</BaseLayout>
