---
import type { ImageMetadata } from "astro";
import BlockLink from "../BlockLink/BlockLink.astro";
import DateView from "../Date/Date.astro";
import Heading from "../Heading/Heading.astro";
import Image from "../Image/Image.astro";
import Link from "../Link/Link.astro";
import Paragraph from "../Paragraph/Paragraph.astro";
import Stack from "../Stack/Stack.astro";
import Tag from "../Tag/Tag.astro";
import styles from "./CardPost.module.scss";

type Author = {
  name: string;
  slug: string;
};

type Props = {
  title: string;
  date?: Date;
  href: string;
  author?: Author;
  image?: ImageMetadata;
  tags?: string[];
};

const { title, date, href, author, image, tags } = Astro.props;
---

<BlockLink href={href}>
  <article class={styles.cardPost}>
    <Stack>
      {
        image && (
          <header>
            <Image src={image} alt={title} ratio="wide" />
          </header>
        )
      }

      <Stack gap="medium">
        <Stack gap="none">
          {
            tags && tags.length > 0 && (
              <div>
                <Paragraph size="small" variant="muted">
                  {tags.join(" | ").toUpperCase()}
                </Paragraph>
              </div>
            )
          }
          <Heading level={2} appearance={3}>{title}</Heading>
        </Stack>

        <Stack gap="none">
          {
            author && (
              <Paragraph>
                {"By "}
                <Link href={`/authors/${author.slug}/`}>{author.name}</Link>
              </Paragraph>
            )
          }

          {
            date && (
              <Paragraph size="small" variant="muted">
                {"Published: "}
                <DateView date={date} />
              </Paragraph>
            )
          }
        </Stack>
      </Stack>
    </Stack>
  </article>
</BlockLink>
