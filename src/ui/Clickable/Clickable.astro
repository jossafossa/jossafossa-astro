---
import styles from "./Clickable.module.scss";
import type { ClickableProps } from "./Clickable.types";

const { class: className, ...rest } = Astro.props as ClickableProps;
const isLink = "href" in rest && rest.href;
---

{
  isLink ? (
    <a {...rest} class:list={[styles.clickable, className]}>
      <slot />
    </a>
  ) : (
    <button type="button" {...rest} class:list={[styles.clickable, className]}>
      <slot />
    </button>
  )
}
