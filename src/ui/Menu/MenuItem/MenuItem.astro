---
import Link from "../../Link/Link.astro";
import styles from "./MenuItem.module.scss";

type Props = {
  href: string;
  active: boolean;
};

const { href, active } = Astro.props;
---

<li>
  {
    active ? (
      <span class={styles.active}>
        <slot />
      </span>
    ) : (
      <Link href={href}>
        <slot />
      </Link>
    )
  }
</li>
