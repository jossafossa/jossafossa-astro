---

import {
  Body,
  Page,
  Main,
  Header,
  Footer,
  Stack,
  BlockLink,
  Logo,
  Menu,
  MenuItem,
  Paragraph,
  DarkModeToggle,
} from "@/ui";
const themeInitScript = `(function(){var s=localStorage.getItem('theme');var d=s==='dark'||(s===null&&matchMedia('(prefers-color-scheme: dark)').matches);document.documentElement.dataset.theme=d?'dark':'light';})();`;
import { navigation } from "@/data";
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Mono:wght@100..900&family=Noto+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <script is:inline set:html={themeInitScript}></script>
  </head>

  <Body>
    <Page>
      <Header>
        <Stack horizontal align="center" justify="space-between">
          <BlockLink href="/">
            <Logo />
          </BlockLink>

          <Stack horizontal align="center" gap="large">
            <Menu>
              {navigation.main.map((item) => (
                <MenuItem
                  href={item.href}
                  active={item.href === Astro.url.pathname}
                >
                  {item.label}
                </MenuItem>
              ))}
            </Menu>

            <DarkModeToggle />
          </Stack>
        </Stack>
      </Header>
      <Main>
        <slot />
      </Main>
      <Footer>
        <Stack horizontal justify="space-between" align="center">
          <Paragraph>&copy; {new Date().getFullYear()} My Blog</Paragraph>
          <BlockLink href="/">
            <Logo />
          </BlockLink>
        </Stack>
      </Footer>
    </Page>
  </Body>
</html>

<style is:global lang="scss">
  @use "../styles/main";
</style>
