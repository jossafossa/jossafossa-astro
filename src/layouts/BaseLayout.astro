---
import { Footer, Menu, Header, Body } from "@/components";
import { navigation } from "@/data";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <Body>
    <Header>
      <Menu>
        {navigation.main.map((item) => (
          <Menu.Item href={item.href} active={item.href === Astro.url.pathname}
          >
            {item.label}
          </Menu.Item>
        ))}
      </Menu>
    </Header>

    <main>
      <slot />
    </main>

    <Footer />
  </Body>
</html>

<style is:global lang="scss">
  @use "../styles/main";
</style>
