{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/ui": ["./src/ui"],
      "@/ui/*": ["./src/ui/*"],
      "@/containers": ["./src/containers"],
      "@/containers/*": ["./src/containers/*"],
      "@/layouts": ["./src/layouts"],
      "@/layouts/*": ["./src/layouts/*"],
      "@/data": ["./src/data"],
      "@/data/*": ["./src/data/*"],
      "@/styles": ["./src/styles"],
      "@/styles/*": ["./src/styles/*"],
      "@/assets": ["./src/assets"],
      "@/assets/*": ["./src/assets/*"],
      "@/content": ["./src/content"],
      "@/content/*": ["./src/content/*"],
      "@/utils": ["./src/utils"],
      "@/utils/*": ["./src/utils/*"]
    }
  }
}
