{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/components": ["./src/components"],
      "@/components/*": ["./src/components/*"],
      "@/features": ["./src/features"],
      "@/features/*": ["./src/features/*"],
      "@/layouts": ["./src/layouts"],
      "@/layouts/*": ["./src/layouts/*"],
      "@/data": ["./src/data"],
      "@/data/*": ["./src/data/*"],
      "@/styles": ["./src/styles"],
      "@/styles/*": ["./src/styles/*"],
      "@/assets": ["./src/assets"],
      "@/assets/*": ["./src/assets/*"],
      "@/content": ["./src/content"],
      "@/content/*": ["./src/content/*"]
    }
  }
}